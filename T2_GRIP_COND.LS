/PROG  T2_GRIP_COND	  Cond
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "monitor";
PROG_SIZE	= 226;
CREATE		= DATE 22-12-28  TIME 21:20:02;
MODIFIED	= DATE 26-08-31  TIME 18:04:02;
FILE_NAME	= T1_GRIP_;
VERSION		= 0;
LINE_COUNT	= 1;
MEMORY_SIZE	= 602;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/MN
   1:  WHEN RI[1:OFF:T2 opened]=ON OR RI[2:OFF:T2 closed]=ON,CALL T2_DET_LOST ;
/POS
/END
