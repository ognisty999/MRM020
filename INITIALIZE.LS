/PROG  INITIALIZE
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 3160;
CREATE		= DATE 25-04-05  TIME 17:44:40;
MODIFIED	= DATE 26-08-31  TIME 17:35:12;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 152;
MEMORY_SIZE	= 3704;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  JMP LBL[1] ;
   2:  !new calibration ;
   3:  !vice frames, spaces ;
   4:  CALL SET_FRAMES    ;
   5:  CALL SET_SPC    ;
   6:  MESSAGE[< kalibracja] ;
   7:  PAUSE ;
   8:  LBL[1:calibrated] ;
   9:   ;
  10:  PAYLOAD[1:gripper] ;
  11:   ;
  12:  !outputs, flags ;
  13:  DO[1:OFF:start cnc]=OFF ;
  14:  DO[2:OFF:open vice1]=OFF ;
  15:  DO[3:OFF:close vice1]=OFF ;
  16:  DO[4:OFF:open vice2]=OFF ;
  17:  DO[5:OFF:close vice2]=OFF ;
  18:  F[2:OFF:# pick up err]=(OFF) ;
  19:  F[3:OFF:# starting cnc]=(OFF) ;
  20:  F[5:ON :# NO close d / start cnc]=(OFF) ;
  21:  F[6:OFF:# skip deep lathe]=(OFF) ;
  22:  IF (DO[64:OFF:AUTO mode]) THEN ;
  23:  F[21:ON :teach V1 T2]=(OFF) ;
  24:  F[22:ON :teach V1 T1]=(OFF) ;
  25:  F[23:ON :teach V2 T2]=(OFF) ;
  26:  F[24:ON :teach V2 T1]=(OFF) ;
  27:  F[25:OFF:teach tray T1]=(OFF) ;
  28:  F[26:OFF:teach tray T2]=(OFF) ;
  29:  ENDIF ;
  30:   ;
  31:  !production, gripper mode ;
  32:  IF (F[25:OFF:teach tray T1] OR F[26:OFF:teach tray T2]) THEN ;
  33:  R[10:production mode]=0    ;
  34:  MONITOR END BASE_RDY_COND ;
  35:  //R[15:grip in1 / out2]=0    ;
  36:  ELSE ;
  37:  IF (R[10:production mode]=0) THEN ;
  38:  MESSAGE[# tryb produkcji] ;
  39:  PAUSE ;
  40:  ENDIF ;
  41:  IF (R[15:grip in1 / out2]<>1 AND R[15:grip in1 / out2]<>2) THEN ;
  42:  MESSAGE[# tryb chwytaka] ;
  43:  PAUSE ;
  44:  ENDIF ;
  45:  ENDIF ;
  46:   ;
  47:  !tray, vice approaches ;
  48:  CALL RESET_PR(91) ;
  49:  PR[91,3:#Tof tr apr (e)]=R[7:fingers on det]+R[13:tray clearance Z]    ;
  50:  CALL RESET_PR(92) ;
  51:  PR[92,3:#Tof tr apr (f)]=R[11:det H]+R[13:tray clearance Z]    ;
  52:  CALL RESET_PR(94) ;
  53:  PR[94,3:#Tof vi1 apr (f)]=R[3:vi1 clmp on det]+R[14:vice clearance Z]    ;
  54:  CALL RESET_PR(95) ;
  55:  PR[95,3:#Tof vi2 apr (f)]=R[4:vi2 clmp on det]+R[14:vice clearance Z]    ;
  56:  CALL RESET_PR(96) ;
  57:  PR[96,3:#Tof vi apr (e)]=R[7:fingers on det]+R[14:vice clearance Z]    ;
  58:   ;
  59:  IF (F[1:OFF:re-init #pos] OR R[41:# det H (in use)]<>R[11:det H] OR R[42:# det D (in use)]<>R[12:det D] OR R[43:format in use]<>R[20:FORMAT]) THEN ;
  60:   ;
  61:  IF (F[1:OFF:re-init #pos]) THEN ;
  62:  MESSAGE[> reinicjalizacja poz] ;
  63:  PAUSE ;
  64:  ENDIF ;
  65:   ;
  66:   ;
  67:  !loop counters ;
  68:  R[25:# row max]=((R[5:tray length X]-2*R[18:tray fringe X]+R[16:det tr dist X]) DIV (R[12:det D]+R[16:det tr dist X])) ;
  69:  R[26:# col max]=((R[6:tray width Y]-2*R[19:tray fringe Y]+R[17:det tr dist Y]) DIV (R[12:det D]+R[17:det tr dist Y])) ;
  70:   ;
  71:  IF (F[1:OFF:re-init #pos]) THEN ;
  72:  MESSAGE[# maksimum petli] ;
  73:  PAUSE ;
  74:  ENDIF ;
  75:   ;
  76:   ;
  77:  !vice pos used in program ;
  78:  PR[31:# vice1 T1/U6]=PR[1:@ ref vice1 T1]    ;
  79:  CALL RESET_PR(31) ;
  80:  PR[31,3:# vice1 T1/U6]=R[11:det H]-R[1:@ ref det H]    ;
  81:  PR[32:# vice1 T2/U7]=PR[2:@ ref vice1 T2]    ;
  82:  CALL RESET_PR(32) ;
  83:  PR[32,3:# vice1 T2/U7]=R[11:det H]-R[1:@ ref det H]    ;
  84:  PR[33:# vice2 T1/U8]=PR[3:@ ref vice2 T1]    ;
  85:  CALL RESET_PR(33) ;
  86:  PR[33,3:# vice2 T1/U8]=R[11:det H]-R[1:@ ref det H]    ;
  87:  PR[34:# vice2 T2/U9]=PR[4:@ ref vice2 T2]    ;
  88:  CALL RESET_PR(34) ;
  89:  PR[34,3:# vice2 T2/U9]=R[11:det H]-R[1:@ ref det H]    ;
  90:   ;
  91:  !tray 1 pos used in program ;
  92:  PR[7:# tray 1 T1/U1]=PR[5:@ ref tr 1 T1/U1]    ;
  93:  PR[7,1:# tray 1 T1/U1]=(PR[7,1:# tray 1 T1/U1]+(R[12:det D]-R[2:@ ref det D])/2) ;
  94:  PR[7,2:# tray 1 T1/U1]=(PR[7,2:# tray 1 T1/U1]+(R[12:det D]-R[2:@ ref det D])/2) ;
  95:  PR[7,3:# tray 1 T1/U1]=(PR[7,3:# tray 1 T1/U1]+R[11:det H]-R[1:@ ref det H]) ;
  96:  PR[8:# tray 1 T2/U1]=PR[6:@ ref tr 1 T2/U1]    ;
  97:  PR[8,1:# tray 1 T2/U1]=(PR[8,1:# tray 1 T2/U1]+(R[12:det D]-R[2:@ ref det D])/2) ;
  98:  PR[8,2:# tray 1 T2/U1]=(PR[8,2:# tray 1 T2/U1]+(R[12:det D]-R[2:@ ref det D])/2) ;
  99:  PR[8,3:# tray 1 T2/U1]=(PR[8,3:# tray 1 T2/U1]+R[11:det H]-R[1:@ ref det H]) ;
 100:   ;
 101:  IF (F[1:OFF:re-init #pos]) THEN ;
 102:  MESSAGE[> pozycje tacki det 1] ;
 103:  PAUSE ;
 104:  ENDIF ;
 105:   ;
 106:  IF (F[25:OFF:teach tray T1] OR F[26:OFF:teach tray T2]),CALL GO_TABLE_T1 ;
 107:  IF (F[25:OFF:teach tray T1]),CALL TEACH_TRAY_1_T1 ;
 108:  IF (F[26:OFF:teach tray T2]),CALL TEACH_TRAY_1_T2 ;
 109:  IF (F[25:OFF:teach tray T1] OR F[26:OFF:teach tray T2]),CALL GO_TABLE_T2 ;
 110:   ;
 111:  CALL CALCULATE_T1    ;
 112:  CALL CALCULATE_T2    ;
 113:   ;
 114:  F[1:OFF:re-init #pos]=(OFF) ;
 115:  R[41:# det H (in use)]=R[11:det H]    ;
 116:  R[42:# det D (in use)]=R[12:det D]    ;
 117:  R[43:format in use]=R[20:FORMAT]    ;
 118:  ENDIF ;
 119:   ;
 120:  IF (F[21:ON :teach V1 T2] OR F[22:ON :teach V1 T1] OR F[23:ON :teach V2 T2] OR F[24:ON :teach V2 T1]) THEN ;
 121:   ;
 122:  F[5:ON :# NO close d / start cnc]=(ON) ;
 123:   ;
 124:  MESSAGE[> pozycje w imadlach] ;
 125:  PAUSE ;
 126:  IF (!F[21:ON :teach V1 T2] OR !F[24:ON :teach V2 T1]) THEN ;
 127:  MESSAGE[! PR32/33 obl odmuchu] ;
 128:  PAUSE ;
 129:  ENDIF ;
 130:   ;
 131:  CALL GO_IN_LATHE_T2    ;
 132:   ;
 133:  IF (F[21:ON :teach V1 T2]),CALL TEACH_VICE1_T2 ;
 134:  IF (F[22:ON :teach V1 T1]),CALL TEACH_VICE1_T1 ;
 135:  IF (F[23:ON :teach V2 T2]),CALL TEACH_VICE2_T2 ;
 136:  IF (F[24:ON :teach V2 T1]),CALL TEACH_VICE2_T1 ;
 137:   ;
 138:  CALL GO_OUT_LATHE_T2    ;
 139:   ;
 140:  F[5:ON :# NO close d / start cnc]=(OFF) ;
 141:   ;
 142:  !blow positions ;
 143:  IF (F[21:ON :teach V1 T2] OR F[24:ON :teach V2 T1]),CALL SET_BLOW_POS ;
 144:  F[21:ON :teach V1 T2]=(OFF) ;
 145:  F[22:ON :teach V1 T1]=(OFF) ;
 146:  F[23:ON :teach V2 T2]=(OFF) ;
 147:  F[24:ON :teach V2 T1]=(OFF) ;
 148:  ENDIF ;
 149:   ;
 150:  !blow approach ;
 151:  CALL RESET_PR(71) ;
 152:  PR[71,3:#of blow apr]=R[8:blow apr]    ;
/POS
/END
